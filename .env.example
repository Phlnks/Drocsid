# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Backend URL for Electron client
VITE_BACKEND_URL=

# LiveKit Config (Required for Voice & Video)
# Obtain these from your LiveKit Cloud dashboard or self-hosted deployment
VITE_LIVEKIT_URL=wss://<your-project>.livekit.cloud
VITE_LIVEKIT_TOKEN_ENDPOINT=http://localhost:3000/api/livekit/token # Endpoint to fetch tokens
